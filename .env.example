# Copy this file to .env and fill in the values.

# PostgreSQL connection string. For local dev, either run a local Postgres or use a free
# cloud instance (e.g. https://neon.tech, https://supabase.com) — grab the connection
# string from your provider and paste it here. The same URL is what you'll set as the
# DATABASE_URL environment variable in your Vercel project when deploying.
#
# IMPORTANT: if your provider gives you a "pooled"/"pgbouncer" connection string (common
# for serverless hosting — e.g. Neon's pooled endpoint has "-pooler" in the hostname,
# Supabase's "Transaction pooler" uses port 6543), append &pgbouncer=true to the URL like
# the example below. Without it, Prisma may fail with "prepared statement already exists".
# A direct (non-pooled) connection string does not need this flag but it's safe either way.
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/calocount?sslmode=require&pgbouncer=true"

# Auth.js (NextAuth) secret used to sign session tokens/JWTs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Google Gemini API key for AI food recognition (vision model).
# Leave empty to run the app in built-in DEMO mode with a mock analyzer.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Optional: override the vision model used for analysis
GEMINI_MODEL="gemini-flash-latest"

# Optional: only needed when deploying to Vercel (or any serverless host without a
# persistent local disk). Create a Blob store under your Vercel project's Storage tab —
# it auto-fills this token for you there. Leave empty for local dev: meal photos then
# save to public/uploads instead.
BLOB_READ_WRITE_TOKEN=""

# Optional: limit how many photos a single user can analyze, to protect your Gemini
# quota/cost from being burned through by accident or abuse once the app is public.
ANALYZE_RATE_LIMIT_PER_MINUTE="5"
ANALYZE_RATE_LIMIT_PER_DAY="30"

# Optional: limit how many times a single user can auto-estimate calories when manually
# typing in a food item (text-only Gemini call, cheaper than photo analysis so the
# default budget is more generous).
ESTIMATE_RATE_LIMIT_PER_MINUTE="20"
ESTIMATE_RATE_LIMIT_PER_DAY="150"
